@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@NEP_ADAPTERS_PACKAGE_NEEDS_OPENMP@)
  find_dependency(OpenMP COMPONENTS CXX)
endif()
if(@NEP_ADAPTERS_PACKAGE_NEEDS_BLAS@)
  find_dependency(BLAS)
endif()
if(@NEP_ADAPTERS_PACKAGE_NEEDS_CUDATOOLKIT@)
  find_dependency(CUDAToolkit)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/NEPAdaptersTargets.cmake")
